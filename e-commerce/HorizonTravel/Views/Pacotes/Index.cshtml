@model IEnumerable<HorizonTravel.Models.Pacote>

@{
    ViewData["Title"] = "Pacotes";
    
    // Usa o que vem do banco. Se estiver vazio, não quebra a tela.
    var listaExibicao = Model ?? new List<HorizonTravel.Models.Pacote>();
    var promocoes = ViewBag.Promocoes as IEnumerable<HorizonTravel.Models.Promocao>
        ?? Enumerable.Empty<HorizonTravel.Models.Promocao>();
}

<link rel="stylesheet" href="~/css/pacotes.css" asp-append-version="true" />

<section class="banner-pacotes">
    <img src="https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=1600&auto=format&fit=crop" alt="Paisagem de viagem" />
    <div class="conteudo-banner-pacotes">
        <h1>NOSSOS<br />PACOTES</h1>
        <p>Encontre o seu destino ideal.<br />Planeje sua próxima experiência.</p>
    </div>
</section>

<section class="envoltorio-busca-pacotes">
    <form class="barra-busca-pacotes" asp-controller="Pacotes" asp-action="Index" method="get">
        <div class="campo-busca">
            <i class="bi bi-geo-alt text-secondary"></i>
            <input type="text" name="origem" value="@Context.Request.Query["origem"]" placeholder="Origem" aria-label="Origem" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-geo-alt text-secondary"></i>
            <input type="text" name="destino" value="@Context.Request.Query["destino"]" placeholder="Destino" aria-label="Destino" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-calendar-event text-secondary"></i>
            <input type="date" name="data" value="@Context.Request.Query["data"]" aria-label="Data" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-people text-secondary"></i>
            <input type="number" name="pessoas" min="1" value="@Context.Request.Query["pessoas"]" placeholder="Nº de pessoas" aria-label="Número de pessoas" />
        </div>
        <button type="submit" class="btn btn-login">Buscar</button>
    </form>
</section>

<main class="conteudo-pacotes">
    <section class="filtros-pacotes">
        <div>
            <i class="bi bi-sliders"></i>
            <span>Filtrar por:</span>
            <a class="filtro-pacote @(string.IsNullOrEmpty(Context.Request.Query["destino"]) ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index">Todos</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "Brasil" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="Brasil">Brasil</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "Japão" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="Japão">Japão</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "Estados Unidos" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="Estados Unidos">Estados Unidos</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "França" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="França">França</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "Itália" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="Itália">Itália</a>
            <a class="filtro-pacote @(Context.Request.Query["destino"] == "Inglaterra" ? "filtro-ativo" : "")" asp-controller="Pacotes" asp-action="Index" asp-route-destino="Inglaterra">Inglaterra</a>
        </div>
        <form class="formulario-ordenacao" asp-controller="Pacotes" asp-action="Index" method="get">
            <input type="hidden" name="origem" value="@Context.Request.Query["origem"]" />
            <input type="hidden" name="destino" value="@Context.Request.Query["destino"]" />
            <input type="hidden" name="data" value="@Context.Request.Query["data"]" />
            <input type="hidden" name="pessoas" value="@Context.Request.Query["pessoas"]" />
            <select name="ordenacao" aria-label="Ordenar pacotes" onchange="this.form.submit()">
                <option value="popularidade" selected="@(string.IsNullOrEmpty(Context.Request.Query["ordenacao"]) || Context.Request.Query["ordenacao"] == "popularidade")">Popularidade</option>
                <option value="menor-preco" selected="@(Context.Request.Query["ordenacao"] == "menor-preco")">Menor preço</option>
                <option value="maior-preco" selected="@(Context.Request.Query["ordenacao"] == "maior-preco")">Maior preço</option>
            </select>
        </form>
    </section>

    <p class="total-pacotes"><strong>@listaExibicao.Count()</strong> pacotes encontrados</p>

    <section class="grade-pacotes">
        @if (listaExibicao.Any())
        {
            @foreach (var pacote in listaExibicao)
            {
                var promocao = HorizonTravel.Libraries.Promocao.PromocaoCalculadora
                    .ObterMelhorPromocao(pacote, promocoes);
                var precoPromocional = promocao == null
                    ? pacote.precoPac
                    : Math.Round(pacote.precoPac * (1 - promocao.porcentagemDesconto / 100), 2);
                <article class="cartao-pacote">
                    <div class="container-imagem-pacote">
                        <img src="@(string.IsNullOrWhiteSpace(pacote.fotoPac) ? "https://images.unsplash.com/photo-1476514525535-07fb3b4ae5f1?q=80&w=600" : pacote.fotoPac)" alt="Pacote para @pacote.destinoPac" />
                        <span class="etiqueta-destino">@pacote.destinoPac</span>
                        @if (promocao != null)
                        {
                            <span class="etiqueta-promocao">@promocao.nomePromocao - @promocao.porcentagemDesconto.ToString("0.##")% OFF</span>
                        }
                    </div>

                    <div class="corpo-cartao-pacote">
                        <h2>@pacote.destinoPac</h2>
                        
                        <p class="descricao-pacote">
                            @if (pacote.destinoPac == "Brasil")
                            {
                                <text>Descubra praias, natureza e experiências inesquecíveis.</text>
                            }
                            else if (pacote.destinoPac == "França")
                            {

                                <text>Encante-se com elegância, história e charme.</text>
                            }
                            else if (pacote.destinoPac == "Japão")
                            {

                                <text>Tradição, tecnologia e paisagens surpreendentes.</text>
                            }
                            else if (pacote.destinoPac == "México")
                            {

                                <text>Cores, cultura e paisagens fascinantes.</text>
                            }
                            else
                            {

                                <text>@pacote.origemPac → @pacote.destinoPac</text>
                            }
                        </p>

                        <!-- ===== ÁREA DE AVALIAÇÃO ===== -->
                        <div class="rodape-cartao-pacote">
                            <div class="area-avaliacao">
                                <div class="avaliacao-estrelas">
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                    <i class="bi bi-star-fill"></i>
                                </div>
                                <!-- Link correto apontando para a Controller Avaliacao, Action Index -->
                                <a asp-controller="Avaliacao" asp-action="Index" asp-route-id="@pacote.IDPac" class="link-avaliar">
                                    Avaliar pacote
                                </a>
                            </div>
                            <span class="qtd-vagas">@pacote.quantidadePac passageiros</span>
                        </div>
                        
                        <div class="preco-acao">
                            <span>
                                A partir de
                                @if (promocao != null)
                                {
                                    <del>R$ @pacote.precoPac.ToString("N2")</del>
                                }
                                <strong>R$ @precoPromocional.ToString("N2")</strong>
                            </span>
                            <!-- Corrigido para apontar para a Action Detalhes -->
                            <a asp-controller="Pacotes" asp-action="Detalhes" asp-route-id="@pacote.IDPac" class="btn-ver-pacote">Ver pacote</a>
                        </div>
                    </div>
                </article>
            }
        }
        else
        {
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px; color: #666;">
                <h3>Nenhum pacote encontrado no momento.</h3>
                <p>Adicione pacotes no banco de dados para vê-los aqui.</p>
            </div>
        }
    </section>
</main>
