        <div class="row g-4 mt-2 justify-content-center">
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beneficio">
                    <span class="beneficio-icone icone-azul"><i class="bi bi-shield-check"></i></span>
                    <h3 class="titulo-beneficio">Segurança</h3>
                    <p class="texto-beneficio">Nossa empresa oferece viagens seguras ao redor do mundo</p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beneficio">
                    <span class="beneficio-icone icone-amarelo"><i class="bi bi-currency-dollar"></i></span>
                    <h3 class="titulo-beneficio">Melhor preço</h3>
                    <p class="texto-beneficio">Nossa empresa oferece viagens seguras ao redor do mundo</p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beneficio">
                    <span class="beneficio-icone icone-amarelo-claro"><i class="bi bi-lightning-charge-fill"></i></span>
                    <h3 class="titulo-beneficio">Rapidez</h3>
                    <p class="texto-beneficio">Nossa empresa oferece viagens seguras ao redor do mundo</p>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-lg-3">
                <div class="beneficio">
                    <span class="beneficio-icone icone-verde"><i class="bi bi-globe-americas"></i></span>
