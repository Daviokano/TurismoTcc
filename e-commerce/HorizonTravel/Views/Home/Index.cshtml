                    </div>
                </div>
            </div>

            <!-- VIDEO -->
            <div class="col-12 col-lg-7">
                <div class="viaje-card">
                    <!--trocar imagem dps-->
                    <img src="~/img/video-img.jpg" asp-append-version="true" alt="Praia paradisíaca" />
                    <div class="viaje-overlay">
                        <h3 class="viaje-titulo">Viaje e aproveite suas férias</h3>
                        <p class="viaje-texto">Explore paisagens incríveis, culturas diferentes e viva momentos inesquecíveis</p>
                        <a href="#" class="btn btn-login"><i class="bi bi-play-fill"></i> Assistir vídeo</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<hr />

