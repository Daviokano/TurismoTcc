@{
    ViewData["Title"] = "Home Page";
}

<link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
<script src="~/js/index.js"></script>

<!-- BANNER INICIAL DA PÁG. -->
<div class="container-fluid p-0">
    <div class="banner">
        <img src="/img/img banner.jpg" alt="banner" asp-append-version="true">

        <div class="banner-conteudo">
            <h2 class="titulo-banner">VISITE DESTINOS INCRÍVEIS</h2>
            <p class="texto-banner">Descubra lugares paradisíacos e viva experiências únicas<br /> ao redor do mundo.</p>
            <a id="btn-banner" class="btn btn-primary" asp-controller="Destinos" asp-action="Index">Explorar Destinos</a>
        </div>

    </div>
</div>


<!-- BUSCA DE PACOTES/ DESTINOS -->
<section class="envoltorio-busca-pacotes">
    <form class="barra-busca-pacotes" asp-controller="Pacotes" asp-action="Index" method="get">
        <div class="campo-busca">
            <i class="bi bi-geo-alt text-secondary"></i>
            <input type="text" name="origem" placeholder="Origem" aria-label="Origem" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-geo-alt text-secondary"></i>
            <input type="text" name="destino" placeholder="Destino" aria-label="Destino" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-calendar-event text-secondary"></i>
            <input type="date" name="data" aria-label="Data" />
        </div>
        <div class="campo-busca">
            <i class="bi bi-people text-secondary"></i>
            <input type="number" name="pessoas" min="1" placeholder="Nº de pessoas" aria-label="Número de pessoas" />
        </div>
        <button type="submit" class="btn btn-login">Buscar</button>
    </form>
</section>


<!-- PRESENTAÇÃO DOS DESTINOS EM DESTAQUE -->
<!-- título e texto -->
<div class="container">
    <div class="text">
        <h4 class="titulo"> Destinos em destaque</h4>
        <p class="texto">Lugares incríveis esperando por você<br />Escolha se próximo destino e viva experiências únicas.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mt-1">

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card paris.jpg"
                     asp-append-version="true"
                     class="card-img"
                     alt="Paris, França" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Paris, França</h3>
                    <p class="texto-card">Cidade, Luz e Romance</p>
                </div>
                <a class="btn-card"
                   asp-controller="Pacotes"
                   asp-action="Index"
                   asp-route-destino="França"
                   aria-label="Ver pacotes para a França">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card orlando.jpeg"
                     asp-append-version="true"
                     class="card-img"
                     alt="Orlando, Estados Unidos" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Orlando, EUA</h3>
                    <p class="texto-card">Parque da Disney</p>
                </div>
                <a class="btn-card"
                   asp-controller="Pacotes"
                   asp-action="Index"
                   asp-route-destino="Estados Unidos"
                   aria-label="Ver pacotes para os Estados Unidos">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card copacabana.jpeg"
                     asp-append-version="true"
                     class="card-img"
                     alt="Copacabana, Brasil" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Copacabana, Brasil</h3>
                    <p class="texto-card">Praias incríveis</p>
                </div>
                <a class="btn-card"
                   asp-controller="Pacotes"
                   asp-action="Index"
                   asp-route-destino="Brasil"
                   aria-label="Ver pacotes para o Brasil">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        </div>

        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card pisa.jpeg"
                     asp-append-version="true"
                     class="card-img"
                     alt="Pisa, Itália" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Pisa, Itália</h3>
                    <p class="texto-card">Cidade da famosa torre</p>
                </div>
                <a class="btn-card"
                   asp-controller="Pacotes"
                   asp-action="Index"
                   asp-route-destino="Itália"
                   aria-label="Ver pacotes para a Itália">
                    <i class="bi bi-arrow-right"></i>
                </a>
            </article>
        </div>
    </div>
</div>

