                        <div>
                            <div class="procurado-nome"><span class="procurado-numero">2</span> Estados Unidos</div>
                            <div class="estrelas">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                            </div>
                        </div>
                    </div>

                    <div class="procurado-item">
                        <img src="~/img/brasil-procurados.jpg" asp-append-version="true" class="procurado-img" alt="img" />
                        <div>
                            <div class="procurado-nome"><span class="procurado-numero">3</span> Brasil</div>
