@model HorizonTravel.Models.MinhasReservasViewModel
@using HorizonTravel.Models.Constant

@{
    ViewData["Title"] = "Minhas reservas";
}

@section Styles {
    <link rel="stylesheet" href="~/css/reservas-usuario.css" asp-append-version="true" />
}

<section class="pagina-usuario">
    <div class="cabecalho-usuario">
        <div class="avatar-usuario">@Model.Usuario.nomeUsu.Substring(0, 1).ToUpper()</div>
        <div>
            <h1>@Model.Usuario.nomeUsu</h1>
            <p>@Model.Usuario.emailUsu</p>
        </div>
    </div>

    <nav class="abas-usuario" aria-label="Navegação do usuário">
        <a asp-controller="Home" asp-action="MeuPerfil">Meu perfil</a>
        <a class="aba-ativa" asp-controller="Home" asp-action="MinhasReservas">Minhas reservas</a>
        <a asp-controller="Home" asp-action="PainelUsuario">Histórico</a>
    </nav>

    <section class="lista-reservas" aria-label="Lista de reservas">
        @if (!Model.Reservas.Any())
        {
            <p>Você ainda não possui reservas.</p>
        }
        else
        {
            @foreach (var reserva in Model.Reservas)
            {
                var codigoReserva = $"HT{reserva.IDRes:000000}";
                <article class="cartao-reserva">
                    <div>
                        <h2>@reserva.destinoPac</h2>
                        <p><i class="bi bi-calendar3"></i> Partida: @reserva.dataPac.ToString("dd/MM/yyyy") - @reserva.quantidadePassageiros passageiro(s)</p>
                        <p>Pagamento: @reserva.metodoPag (@reserva.statusPag)</p>
                    </div>
                    <div class="dados-reserva">
                        <strong>R$ @reserva.valorPag.ToString("N2")</strong>
                        <span class="status-reserva">@reserva.statusRes</span>
                        <small>#@codigoReserva</small>
                        @if (reserva.statusPag == StatusPagamentoConstant.Pendente)
                        {
                            <a asp-controller="Reserva"
                               asp-action="Confirmacao"
                               asp-route-id="@reserva.IDRes"
                               class="botao-pagar-reserva">
                                Pagar agora
                            </a>
                        }
                    </div>
                </article>
            }
        }
    </section>
</section>
