@model HorizonTravel.Models.ReservaDetalhesViewModel
@using HorizonTravel.Models.Constant

@{
    ViewData["Title"] = "Confirmação da reserva";
    bool pagamentoPendente = Model.Reserva.statusPag == StatusPagamentoConstant.Pendente;
    bool pagamentoCancelado = Model.Reserva.statusPag == StatusPagamentoConstant.Cancelado;
    string codigoReserva = $"HT{Model.Reserva.IDRes:000000}";
}

<link rel="stylesheet" href="~/css/reserva-checkout.css" asp-append-version="true" />

<main class="pagina-reserva">
    <section class="cabecalho-reserva">
        <h1>Reservar Pacote</h1>
        <p>Confira os dados da sua reserva.</p>
    </section>

    <ol class="progresso-reserva" aria-label="Etapas da reserva">
        <li class="concluido">
            <span class="icone-progresso-reserva"><i class="bi bi-check-lg"></i></span>
            <span>Passageiros</span>
        </li>
        <li class="concluido">
            <span class="icone-progresso-reserva"><i class="bi bi-check-lg"></i></span>
            <span>Pagamento</span>
        </li>
        <li class="ativo">
            <span class="icone-progresso-reserva"><i class="bi bi-check-lg"></i></span>
            <span>Confirmação</span>
        </li>
    </ol>

    <section class="cartao-reserva cartao-confirmacao-reserva">
        <div class="icone-confirmacao @(pagamentoCancelado ? "cancelado" : string.Empty)">
            <i class="bi @(pagamentoCancelado ? "bi-x-lg" : "bi-patch-check-fill")"></i>
        </div>

        <h2>
            @(pagamentoCancelado
                ? "Pagamento cancelado"
                : pagamentoPendente
                    ? "Aguardando confirmação"
                    : "Reserva confirmada!")
        </h2>

        <p class="descricao-confirmacao">
            @(pagamentoCancelado
                ? "A reserva foi cancelada e as vagas voltaram a ficar disponíveis."
                : pagamentoPendente
                    ? "Simule a confirmação do pagamento para finalizar sua reserva."
                    : "Seu pagamento foi confirmado e sua reserva está garantida.")
        </p>

        <div class="codigo-reserva">
            <span>Código da reserva</span>
            <strong>@codigoReserva</strong>
        </div>

        <dl class="resumo-confirmacao">
            <div>
                <dt>Pacote</dt>
                <dd>@Model.Reserva.destinoPac</dd>
            </div>
            <div>
                <dt>Valor</dt>
                <dd>R$ @Model.Reserva.valorPag.ToString("N2")</dd>
            </div>
            <div>
                <dt>Pagamento</dt>
                <dd>@Model.Reserva.metodoPag</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>@Model.Reserva.statusPag</dd>
            </div>
        </dl>

        @if (pagamentoPendente)
        {
            <div class="acoes-reserva acoes-reserva-empilhadas">
                <form asp-action="ConfirmarPagamento" method="post">
                    <input name="id" type="hidden" value="@Model.Reserva.IDRes" />
                    <button type="submit" class="botao-reserva botao-reserva-principal">Simular pagamento aprovado</button>
                </form>
                <form asp-action="CancelarPagamento" method="post">
                    <input name="id" type="hidden" value="@Model.Reserva.IDRes" />
                    <button type="submit" class="botao-reserva botao-reserva-contorno">Cancelar pagamento</button>
                </form>
            </div>
        }

        <div class="acoes-reserva">
            <a asp-controller="Home" asp-action="MinhasReservas" class="botao-reserva botao-reserva-secundario">Minhas reservas</a>
            <a asp-controller="Home" asp-action="Index" class="botao-reserva botao-reserva-principal">Voltar ao início</a>
        </div>
    </section>
</main>
