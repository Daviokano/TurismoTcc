@{
    ViewData["Title"] = "Destinos";
}

<link rel="stylesheet" href="~/css/destinos.css" asp-append-version="true" />

<section class="banner-destinos">
    <img src="~/img/destino-eua.png" alt="Paisagem de destino turístico" />
    <img src="~/img/destinoimg.jpg" alt="Paisagem de destino turístico" />
    <div class="conteudo-banner-destinos">
        <p>Explore o mundo e encontre...</p>
        <h1>DESTINOS<br />INCRÍVEIS!</h1>
        <span>Descubra onde será sua próxima aventura</span>
    </div>
</section>

<section class="conteudo-destinos">
    <div class="cabecalho-destinos">
        <h2>Todos os destinos</h2>
        <span></span>
    </div>

    <div class="grade-destinos">
        @foreach (var destino in new[] {
            ("Brasil", "brasil.jpg", "Descubra praias, natureza e experiências inesquecíveis."),
            ("França", "franca.jpg", "Encante-se com elegância, história e charme."),
            ("Japão", "destino-japao.jpg", "Tradição, tecnologia e paisagens surpreendentes."),
            ("México", "destino-mexico.jpg", "Cores, cultura e paisagens fascinantes."),
            ("Inglaterra", "destino-inglaterra.jpg", "Paisagens clássicas e muita história."),
            ("Disney", "disney.jpg", "Magia, diversão e experiências inesquecíveis."),
            ("Museu do Louvre", "museu-louvre.jpg", "Arte, história e obras-primas inesquecíveis."),
            ("Copacabana", "copacabana.jpg", "Praia icônica, paisagens e energia contagiante."),
            ("Cristo Redentor", "cristo-redentor.jpg", "Uma das maravilhas do mundo com vista espetacular."),
            ("Torre Eiffel", "torre-eiffel.jpg", "Símbolo de elegância e romantismo em Paris."),
            ("Monte Fuji", "monte-fuji.jpg", "Beleza natural e tradição milenar do Japão."),
            ("Templo Senso-ji", "templo-senso-ji.jpg", "Espiritualidade e cultura no coração de Tóquio."),
            ("Chichén Itzá", "chichen-itza.jpg", "Mistério e história das civilizações maias."),
            ("Big Ben", "big-ben.jpg", "Ícone histórico e cultural de Londres.")
        })
        {
            <a class="link-destino" asp-controller="Pacotes" asp-action="Index" asp-route-destino="@destino.Item1" aria-label="Ver pacotes para @destino.Item1">
                <article class="cartao-destino">
                <img src="~/img/@destino.Item2" alt="Destino turístico: @destino.Item1" />
                <div class="corpo-cartao-destino">
                    <span>@destino.Item1</span>
                    <h3>@destino.Item1</h3>
                    <p>@destino.Item3</p>
                    <div>
                        <b>★★★★★</b>
                    </div>
                </div>
                </article>
            </a>
        }
    </div>
</section>
