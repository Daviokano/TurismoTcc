@model HorizonTravel.Models.ReservaDetalhesViewModel

@{
    ViewData["Title"] = "Detalhes da reserva";
    string codigoReserva = $"HT{Model.Reserva.IDRes:000000}";
}

<link rel="stylesheet" href="~/css/historico-cliente.css" asp-append-version="true" />

<section class="pagina-historico-cliente">
    <header class="cabecalho-historico-cliente">
        <h1>Reserva #@codigoReserva</h1>
        <p>Dados do cliente, passageiros, pagamento e histórico da reserva.</p>
    </header>

    @if (TempData["MSG_S"] is string mensagem)
    {
        <div class="mensagem-sucesso">@mensagem</div>
    }

    <section class="cartao-resumo-cliente">
        <div class="perfil-resumo-cliente">
            <span class="avatar-resumo-cliente">@Model.Reserva.nomeUsu.Substring(0, 1).ToUpper()</span>
            <div>
                <h2>@Model.Reserva.nomeUsu</h2>
                <p>@Model.Reserva.emailUsu</p>
                <p>@Model.Reserva.telefoneUsu</p>
            </div>
        </div>
        <div class="metrica-resumo-cliente">
            <span>Pacote</span>
            <strong>@Model.Reserva.destinoPac</strong>
        </div>
        <div class="metrica-resumo-cliente">
            <span>Valor</span>
            <strong>R$ @Model.Reserva.valorPag.ToString("N2")</strong>
        </div>
    </section>

    <section class="informacoes-pacote-reserva">
        <div class="cabecalho-informacoes-pacote-reserva">
            <div>
                <span>Resumo da viagem</span>
                <h2>Pacote para @Model.Reserva.destinoPac</h2>
            </div>
        </div>

        <div class="grade-informacoes-pacote-reserva">
            <div>
                <span>Destino</span>
                <strong>@Model.Reserva.destinoPac</strong>
            </div>
            <div>
                <span>Data de partida</span>
                <strong>@Model.Reserva.dataPac.ToString("dd/MM/yyyy")</strong>
            </div>
            <div>
                <span>Passageiros</span>
                <strong>@Model.Passageiros.Count()</strong>
            </div>
            <div>
                <span>Valor total</span>
                <strong>R$ @Model.Reserva.valorPag.ToString("N2")</strong>
            </div>
        </div>
    </section>

    <section class="secao-tabela-historico-cliente">
        <div class="cabecalho-tabela-historico-cliente">
            <h2>Passageiros</h2>
            <span>@Model.Passageiros.Count() passageiro(s)</span>
        </div>
        <div class="envoltorio-tabela-historico-cliente">
        <table class="tabela-historico-cliente">
            <thead>
                <tr>
                    <th>Nome</th>
                    <th>CPF</th>
                    <th>Data de nascimento</th>
                    <th>Passaporte</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var passageiro in Model.Passageiros)
                {
                    <tr>
                        <td>@passageiro.nomeCompleto</td>
                        <td>@passageiro.CPF</td>
                        <td>@passageiro.dataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>@(passageiro.passaporte ?? "Não informado")</td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </section>

</section>
