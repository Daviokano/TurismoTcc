@model HorizonTravel.Models.Promocao
@{ ViewData["Title"] = "Editar promoção"; }
<link rel="stylesheet" href="~/css/promocoes-funcionario.css" asp-append-version="true" />
<div class="pagina-formulario-promocao">
    <div class="cabecalho-promocoes-funcionario">
        <div>
            <h1>Editar promoção</h1>
            <p>Atualize o nome, o desconto ou a data limite da promoção.</p>
        </div>
    </div>

    <section class="cartao-formulario-promocao">
        <form asp-action="Atualizar" method="post">
            <input asp-for="IDPromo" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="erro-promocao"></div>

            <div class="campo-promocao">
                <label asp-for="nomePromocao">Nome da promoção</label>
                <input asp-for="nomePromocao" maxlength="100" />
                <span asp-validation-for="nomePromocao" class="erro-promocao"></span>
            </div>

            <div class="campo-promocao">
                <label asp-for="abrangenciaPromocao">Aplicar para</label>
                <select asp-for="abrangenciaPromocao">
                    <option value="Todos">Todos os pacotes</option>
                    <option value="Brasil">Brasil</option>
                    <option value="França">França</option>
                    <option value="Japão">Japão</option>
                    <option value="México">México</option>
                    <option value="Inglaterra">Inglaterra</option>
                    <option value="Disney">Disney</option>
                    <option value="Parque da Disney">Parque da Disney</option>
                    <option value="Museu do Louvre">Museu do Louvre</option>
                    <option value="Copacabana">Copacabana</option>
                    <option value="Cristo Redentor">Cristo Redentor</option>
                    <option value="Torre Eiffel">Torre Eiffel</option>
                    <option value="Monte Fuji">Monte Fuji</option>
                    <option value="Templo Senso-ji">Templo Senso-ji</option>
                    <option value="Chichén Itzá">Chichén Itzá</option>
                    <option value="Big Ben">Big Ben</option>
                </select>
                <span asp-validation-for="abrangenciaPromocao" class="erro-promocao"></span>
            </div>

            <div class="campo-promocao">
                <label asp-for="porcentagemDesconto">Desconto (%)</label>
                <input asp-for="porcentagemDesconto" type="number" min="0" max="100" step="0.01" />
                <span asp-validation-for="porcentagemDesconto" class="erro-promocao"></span>
            </div>

            <div class="campo-promocao">
                <label asp-for="dataValidade">Data limite</label>
                <input asp-for="dataValidade" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="dataValidade" class="erro-promocao"></span>
            </div>

            <div class="acoes-formulario-promocao">
                <a asp-action="Index">Cancelar</a>
                <button type="submit">Salvar alterações</button>
            </div>
        </form>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
