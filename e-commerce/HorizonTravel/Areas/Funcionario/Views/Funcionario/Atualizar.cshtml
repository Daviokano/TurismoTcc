@using HorizonTravel.Models.Constant
@model HorizonTravel.Models.Funcionario
@{
    ViewBag.Title = "Atualizar Funcionário";
    Layout = "~/Areas/Funcionario/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/atualizar.css" asp-append-version="true" />

<div class="pagina-atualizar">

    <div class="cabecalho-atualizar">
        <h1 class="titulo-atualizar">Atualizar Funcionário</h1>
        <p class="subtitulo-atualizar">Edite os dados do funcionário e salve as alterações.</p>
    </div>

    <section class="secao-atualizar">
        <div class="cartao-atualizar">
            <h2 class="titulo-cartao">Dados do funcionário</h2>

            <form asp-action="Atualizar" method="post" id="formAtualizarFuncionario">
                <input type="hidden" asp-for="IDFun" />

                <div class="grade-atualizar">

                    <div class="campo-form">
                        <label asp-for="nomeFun" class="rotulo-form">Nome Completo</label>
                        <input asp-for="nomeFun" class="input-form" placeholder="Digite o nome completo" maxlength="100" />
                        <span asp-validation-for="nomeFun" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="CPFFun" class="rotulo-form">CPF</label>
                        <input asp-for="CPFFun" class="input-form CPF" placeholder="000.000.000-00"
                               inputmode="numeric" maxlength="14" />
                        <span asp-validation-for="CPFFun" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="emailFun" class="rotulo-form">E-mail</label>
                        <input asp-for="emailFun" class="input-form" placeholder="exemplo@gmail.com" maxlength="100" />
                        <span asp-validation-for="emailFun" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="telefoneFun" class="rotulo-form">Telefone</label>
                        <input asp-for="telefoneFun" class="input-form Telefone" placeholder="(11) 99999-9999" maxlength="15" />
                        <span asp-validation-for="telefoneFun" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="dataNascimentoFun" class="rotulo-form">Data de nascimento</label>
                        <input asp-for="dataNascimentoFun" class="input-form DataNasc" type="text" />
                        <span asp-validation-for="dataNascimentoFun" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label for="permissaoFun" class="rotulo-form">Cargo (opcional)</label>
                        <select id="permissaoFun" name="permissaoFun" class="input-form">
                            <option value="" selected>Manter cargo atual (@Model.permissaoFun)</option>
                            <option value="@PermissaoFunConstant.Administrador">Administrador</option>
                            <option value="@PermissaoFunConstant.Funcionario">Funcionário</option>
                        </select>
                    </div>

                    <div class="campo-form">
                        <label asp-for="senhaFun" class="rotulo-form">Nova Senha (opcional)</label>
                        <div class="campo-senha-wrapper">
                            <input asp-for="senhaFun" class="input-form" type="password" placeholder="Deixe em branco para manter a atual" maxlength="8" data-val="false" />
                            <button type="button" class="botao-olho toggle-senha" title="Mostrar/Ocultar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="senhaFun" class="erro-form"></span>
                    </div>

 
                    <div class="campo-form">
                        <label for="confirmarSenha" class="rotulo-form">Confirmar nova senha</label>
                        <div class="campo-senha-wrapper">
                            <input type="password" id="confirmarSenha" name="confirmarSenha" class="input-form"
                                   placeholder="Confirme a nova senha" maxlength="8" />
                            <button type="button" class="botao-olho toggle-senha" title="Mostrar/Ocultar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span id="erroSenha" class="erro-form" hidden>As senhas não coincidem.</span>
                    </div>

                </div>

                <div class="acoes-form">
                    <a asp-action="Index" class="botao-cancelar">Voltar</a>
                    <button type="submit" class="botao-salvar">Salvar alterações</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const botoesOlho = document.querySelectorAll('.toggle-senha');

            botoesOlho.forEach(botao => {
                botao.addEventListener('click', function() {
                    // Encontra o input de senha que está no mesmo container (wrapper)
                    const input = this.parentElement.querySelector('input');
                    
                    // Alterna o tipo
                    if (input.type === 'password') {
                        input.type = 'text';
                        this.innerHTML = '<i class="bi bi-eye-slash"></i>';
                    } else {
                        input.type = 'password';
                        this.innerHTML = '<i class="bi bi-eye"></i>';
                    }
                });
            });
        });
    </script>
}
