@model HorizonTravel.Models.Usuario
@{
    ViewBag.Title = "Atualizar Usuário";
    Layout = "~/Areas/Funcionario/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/atualizar.css" asp-append-version="true" />

<div class="pagina-atualizar">

    <div class="cabecalho-atualizar">
        <h1 class="titulo-atualizar">Atualizar Usuário</h1>
        <p class="subtitulo-atualizar">Edite os dados do usuário e salve as alterações.</p>
    </div>

    <section class="secao-atualizar">
        <div class="cartao-atualizar">
            <h2 class="titulo-cartao">Dados do usuário</h2>

            <form asp-action="Atualizar" method="post" id="formAtualizarUsuario">
                <input type="hidden" asp-for="IDUsu" />
                <input type="hidden" asp-for="situacaoUsu" />

                <div class="grade-atualizar">

                    <div class="campo-form">
                        <label asp-for="nomeUsu" class="rotulo-form">Nome Completo</label>
                        <input asp-for="nomeUsu" class="input-form" placeholder="Digite o nome completo" maxlength="100" />
                        <span asp-validation-for="nomeUsu" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="CPFUsu" class="rotulo-form">CPF</label>
                        <input asp-for="CPFUsu" class="input-form CPF" placeholder="000.000.000-00"
                               inputmode="numeric" maxlength="14" />
                        <span asp-validation-for="CPFUsu" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="emailUsu" class="rotulo-form">E-mail</label>
                        <input asp-for="emailUsu" class="input-form" placeholder="exemplo@gmail.com" maxlength="100" />
                        <span asp-validation-for="emailUsu" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="telefoneUsu" class="rotulo-form">Telefone</label>
                        <input asp-for="telefoneUsu" class="input-form Telefone" placeholder="(11) 99999-9999" maxlength="15" />
                        <span asp-validation-for="telefoneUsu" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="dataNascimentoUsu" class="rotulo-form">Data de nascimento</label>
                        <input asp-for="dataNascimentoUsu" class="input-form DataNasc" type="text" />
                        <span asp-validation-for="dataNascimentoUsu" class="erro-form"></span>
                    </div>

                    <!-- CAMPO DE SENHA COM OLHINHO -->
                    <div class="campo-form">
                        <label asp-for="senhaUsu" class="rotulo-form">Nova Senha (opcional)</label>
                        <div class="campo-senha-wrapper">
                            <input asp-for="senhaUsu" class="input-form" type="password" placeholder="Deixe em branco para manter a atual" maxlength="8" />
                            <button type="button" class="botao-olho toggle-senha" title="Mostrar/Ocultar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="senhaUsu" class="erro-form"></span>
                    </div>

                    <!-- CONFIRMAR SENHA COM OLHINHO -->
                    <div class="campo-form">
                        <label for="confirmarSenha" class="rotulo-form">Confirmar nova senha</label>
                        <div class="campo-senha-wrapper">
                            <input type="password" id="confirmarSenha" name="confirmarSenha" class="input-form"
                                   placeholder="Confirme a nova senha" maxlength="8" />
                            <button type="button" class="botao-olho toggle-senha" title="Mostrar/Ocultar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span id="erroSenha" class="erro-form" hidden>As senhas não coincidem.</span>
                    </div>

                </div>

                <div class="acoes-form">
                    <a asp-action="Index" class="botao-cancelar">Voltar</a>
                    <button type="submit" class="botao-salvar">Salvar alterações</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const botoesOlho = document.querySelectorAll('.toggle-senha');

            botoesOlho.forEach(botao => {
                botao.addEventListener('click', function() {
                    const input = this.parentElement.querySelector('input');

                    if (input.type === 'password') {
                        input.type = 'text';
                        this.innerHTML = '<i class="bi bi-eye-slash"></i>';
                    } else {
                        input.type = 'password';
                        this.innerHTML = '<i class="bi bi-eye"></i>';
                    }
                });
            });
        });
    </script>
}