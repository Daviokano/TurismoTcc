@model HorizonTravel.Models.HistoricoClienteViewModel

@{
    ViewData["Title"] = "Histórico por cliente";
}

<link rel="stylesheet" href="~/css/historico-cliente.css" asp-append-version="true" />

<section class="pagina-historico-cliente">
    <header class="cabecalho-historico-cliente">
        <h1>Histórico por cliente</h1>
        <p>Consulte todas as reservas realizadas por um cliente.</p>
    </header>

    <form class="busca-cliente" method="get">
        <label class="entrada-busca-cliente">
            <i class="bi bi-search"></i>
            <input name="busca" value="@Model.Busca" placeholder="Buscar cliente por nome ou CPF..." autocomplete="off" />
        </label>
        <button type="submit">Buscar</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Busca) && !Model.ResultadosBusca.Any())
    {
        <section class="historico-cliente-vazio">
            <i class="bi bi-person-x"></i>
            <p>Nenhum cliente foi encontrado para a busca informada.</p>
        </section>
    }

    @if (Model.Cliente == null)
    {
        <section class="secao-lista-clientes">
            <div class="cabecalho-lista-clientes">
                <h2>Clientes cadastrados</h2>
                <span>@Model.Clientes.Count() cliente(s)</span>
            </div>
            <div class="envoltorio-lista-clientes">
                <table class="tabela-lista-clientes">
                    <thead>
                        <tr>
                            <th>Cliente</th>
                            <th>CPF</th>
                            <th>E-mail</th>
                            <th>Telefone</th>
                            <th>Data de nascimento</th>
                            <th>Ação</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Model.Clientes)
                        {
                            <tr>
                                <td>
                                    <div class="perfil-lista-clientes">
                                        <span class="avatar-lista-clientes">@usuario.nomeUsu.Substring(0, 1).ToUpper()</span>
                                        <strong>@usuario.nomeUsu</strong>
                                    </div>
                                </td>
                                <td>@usuario.CPFUsu</td>
                                <td>@usuario.emailUsu</td>
                                <td>@usuario.telefoneUsu</td>
                                <td>@usuario.dataNascimentoUsu.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <a class="acao-lista-clientes" asp-action="Historico" asp-route-id="@usuario.IDUsu">Ver histórico</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Cliente != null)
    {
        <section class="cartao-resumo-cliente">
            <div class="perfil-resumo-cliente">
                <span class="avatar-resumo-cliente">@Model.Cliente.nomeUsu[..1].ToUpper()</span>
                <div>
                    <h2>@Model.Cliente.nomeUsu</h2>
                    <p>E-mail: @Model.Cliente.emailUsu</p>
                    <p>Telefone: @Model.Cliente.telefoneUsu</p>
                </div>
            </div>
            <div class="metrica-resumo-cliente">
                <span>Total de reservas</span>
                <strong>@Model.TotalReservas</strong>
            </div>
            <div class="metrica-resumo-cliente">
                <span>Valor total</span>
                <strong>R$ @Model.ValorTotal.ToString("N2")</strong>
            </div>
        </section>

        <section class="secao-tabela-historico-cliente">
            <div class="cabecalho-tabela-historico-cliente">
                <h2>Histórico de reservas</h2>
                <span>@Model.TotalReservas reserva(s)</span>
            </div>

            @if (!Model.Reservas.Any())
            {
                <section class="historico-cliente-vazio">
                    <i class="bi bi-calendar-x"></i>
                    <p>Este cliente ainda não possui reservas.</p>
                </section>
            }
            else
            {
                <div class="envoltorio-tabela-historico-cliente">
                    <table class="tabela-historico-cliente">
                        <thead>
                            <tr>
                                <th>Reserva</th>
                                <th>Pacote</th>
                                <th>Data</th>
                                <th>Valor</th>
                                <th>Status</th>
                                <th>Ação</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var reserva in Model.Reservas)
                            {
                                var codigoReserva = $"HT{reserva.IDRes:000000}";
                                <tr>
                                    <td>#@codigoReserva</td>
                                    <td>@reserva.destinoPac</td>
                                    <td>@reserva.dataRes.ToString("dd/MM/yyyy")</td>
                                    <td>R$ @reserva.valorPag.ToString("N2")</td>
                                    <td><span class="reservation-status">@reserva.statusRes</span></td>
                                    <td>
                                        <a asp-area="Funcionario"
                                           asp-controller="Reserva"
                                           asp-action="Detalhes"
                                           asp-route-id="@reserva.IDRes">
                                            Visualizar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

    }
</section>
