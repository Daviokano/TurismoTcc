@using HorizonTravel.Models
@using HorizonTravel.Models.Constant
@model IEnumerable<HorizonTravel.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<link rel="stylesheet" href="~/css/listausuario.css" asp-append-version="true" />

@functions {
    string ObterIniciais(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            return "?";
        }

        var partes = nome.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0][0].ToString().ToUpper();
        }

        return (partes[0][0].ToString() + partes[partes.Length - 1][0].ToString()).ToUpper();
    }
}

<div class="pagina-lista">

    <!-- ===== Cabeçalho ===== -->
    <div class="cabecalho-lista">
        <div>
            <h1 class="titulo-lista">Usuários</h1>
            <p class="subtitulo-lista">Gerencie os usuários cadastrados no sistema.</p>
        </div>
    </div>

    <!-- ===== Busca ===== -->
    <div class="area-busca">
        <div class="campo-busca">
            <span class="bi bi-search icone-busca" aria-hidden="true"></span>
            <input type="text" id="campoBusca" class="input-busca"
                   placeholder="Buscar usuário por nome ou CPF..." autocomplete="off" />
        </div>
    </div>

    <!-- ===== Tabela ===== -->
    <div class="cartao-tabela">
        <table class="tabela-usuarios" id="tabelaUsuarios">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>Nascimento</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Usuario usuario in Model)
                {
                    <tr class="linha-usuario">
                        <td>
                            <div class="celula-usuario">
                                <span class="avatar-iniciais">@ObterIniciais(usuario.nomeUsu)</span>
                                <span class="nome-usuario">@usuario.nomeUsu</span>
                            </div>
                        </td>
                        <td class="cpf-usuario">@usuario.CPFUsu</td>
                        <td>@usuario.emailUsu</td>
                        <td class="telefone-usuario">@usuario.telefoneUsu</td>
                        <td class="data-usuario">@usuario.dataNascimentoUsu.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (usuario.situacaoUsu == SituacaoUsuConstant.Ativo)
                            {
                                <span class="selo selo-ativo">Ativo</span>
                            }
                            else
                            {
                                <span class="selo selo-inativo">Inativo</span>
                            }
                        </td>
                        <td>
                            <div class="grupo-acoes">
                                <a asp-action="Atualizar" asp-route-id="@usuario.IDUsu" class="botao-acao botao-editar">Editar</a>

                                @if (usuario.situacaoUsu == SituacaoUsuConstant.Ativo)
                                {
                                    <a asp-action="Desativar" asp-route-id="@usuario.IDUsu"
                                       class="botao-acao botao-desativar"
                                       onclick="return confirm('Realmente deseja desativar esse usuário?');">Desativar</a>
                                }
                                else
                                {
                                    <a asp-action="Ativar" asp-route-id="@usuario.IDUsu"
                                       class="botao-acao botao-ativar"
                                       onclick="return confirm('Realmente deseja ativar esse usuário?');">Ativar</a>
                                }
                            </div>
                        </td>
                    </tr>
                }

                <tr id="linhaSemResultado" class="linha-sem-resultado" hidden>
                    <td colspan="7">Nenhum usuário encontrado.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <!-- Os botões de página são gerados pelo listagem.js (data-por-pagina = registros por página) -->
    <div class="paginacao" id="paginacao" data-por-pagina="3"></div>

    <!-- ===== Cadastro de usuário ===== -->
    <section class="secao-cadastro">
        <div class="cartao-cadastro">
            <h2 class="titulo-cadastro">Cadastrar Usuário</h2>

            <!--
                O model da página é uma lista (IEnumerable), então não dá pra usar asp-for aqui.
                Os campos usam "name" igual às propriedades de Usuario, então o model binding
                do POST Cadastrar(Usuario) continua funcionando.
            -->
            <form asp-action="Cadastrar" method="post" id="formCadastroUsuario" class="form-cadastro">
                <input type="hidden" name="situacaoUsu" value="@SituacaoUsuConstant.Ativo" />

                <div class="grade-cadastro">

                    <div class="campo-form">
                        <label for="nomeUsu" class="rotulo-form">Nome Completo</label>
                        <input type="text" id="nomeUsu" name="nomeUsu" class="input-form"
                               placeholder="Digite o nome completo" maxlength="100" required />
                    </div>

                    <div class="campo-form">
                        <label for="CPFUsu" class="rotulo-form">CPF</label>
                        <input type="text" id="CPFUsu" name="CPFUsu" class="input-form"
                               placeholder="000.000.000-00" inputmode="numeric" maxlength="14" required />
                    </div>

                    <div class="campo-form">
                        <label for="emailUsu" class="rotulo-form">E-mail</label>
                        <input type="email" id="emailUsu" name="emailUsu" class="input-form"
                               placeholder="exemplo@gmail.com" maxlength="100" required />
                    </div>

                    <div class="campo-form">
                        <label for="telefoneUsu" class="rotulo-form">Telefone</label>
                        <input type="tel" id="telefoneUsu" name="telefoneUsu" class="input-form"
                               placeholder="(11) 99999-9999" maxlength="15" required />
                    </div>

                    <div class="campo-form">
                        <label for="dataNascimentoUsu" class="rotulo-form">Data de nascimento</label>
                        <input type="date" id="dataNascimentoUsu" name="dataNascimentoUsu" class="input-form" required />
                    </div>

                    <div class="campo-form">
                        <label for="senhaUsu" class="rotulo-form">Senha</label>
                        <input type="password" id="senhaUsu" name="senhaUsu" class="input-form"
                               placeholder="Digite a senha" maxlength="8" required />
                    </div>

                    <div class="campo-form">
                        <label for="confirmarSenha" class="rotulo-form">Confirmar senha</label>
                        <input type="password" id="confirmarSenha" name="confirmarSenha" class="input-form"
                               placeholder="Confirme a senha" maxlength="8" required />
                        <span id="erroSenha" class="erro-form" hidden>As senhas não coincidem.</span>
                    </div>

                </div>

                <div class="acoes-form">
                    <button type="reset" class="botao-cancelar">Cancelar</button>
                    <button type="submit" class="botao-cadastrar">Cadastrar Usuário</button>
                </div>
            </form>
        </div>
    </section>
</div>

<script src="~/js/listagem.js" asp-append-version="true"></script>
<script src="~/js/cadastrousuario.js" asp-append-version="true"></script>
