@model HorizonTravel.Models.Parceiro
@{
    ViewBag.Title = "Atualizar Parceiro";
    Layout = "~/Areas/Funcionario/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/atualizar.css" asp-append-version="true" />

<div class="pagina-atualizar">

    <div class="cabecalho-atualizar">
        <h1 class="titulo-atualizar">Atualizar Parceiro</h1>
        <p class="subtitulo-atualizar">Edite os dados do parceiro e salve as alterações.</p>
    </div>

    <section class="secao-atualizar">
        <div class="cartao-atualizar">
            <h2 class="titulo-cartao">Dados do parceiro</h2>

            <form asp-action="Atualizar" method="post" id="formAtualizarParceiro">
                <input type="hidden" asp-for="situacaoFor" />
                <input type="hidden" name="cnpjOriginal" value="@Model.CNPJFor" />

                <div class="grade-atualizar">

                    <div class="campo-form">
                        <label asp-for="nomeFor" class="rotulo-form">Nome do parceiro</label>
                        <input asp-for="nomeFor" class="input-form" placeholder="Digite o nome do parceiro" maxlength="100" />
                        <span asp-validation-for="nomeFor" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="CNPJFor" class="rotulo-form">CNPJ</label>
                        <input asp-for="CNPJFor" class="input-form CNPJ" placeholder="00.000.000/0000-00"
                               inputmode="numeric" maxlength="18" />
                        <span asp-validation-for="CNPJFor" class="erro-form"></span>
                    </div>

                    <div class="campo-form">
                        <label asp-for="emailFor" class="rotulo-form">E-mail</label>
                        <input asp-for="emailFor" class="input-form" placeholder="exemplo@gmail.com" maxlength="100" />
                        <span asp-validation-for="emailFor" class="erro-form"></span>
                    </div>

                </div>

                <div class="acoes-form">
                    <a asp-action="Index" class="botao-cancelar">Voltar</a>
                    <button type="submit" class="botao-salvar">Salvar alterações</button>
                </div>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
