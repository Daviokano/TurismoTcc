@model HorizonTravel.Models.Usuario

@{
    ViewData["Title"] = "Meu perfil";
}

<link rel="stylesheet" href="~/css/perfil-usuario.css" asp-append-version="true" />

<section class="pagina-usuario">
    <div class="cabecalho-usuario">
        <div class="avatar-usuario">@Model.nomeUsu.Substring(0, 1).ToUpper()</div>
        <div>
            <h1>@Model.nomeUsu</h1>
            <p>@Model.emailUsu</p>
        </div>
    </div>

    <nav class="abas-usuario" aria-label="Navegação do usuário">
        <a class="aba-ativa" asp-controller="Home" asp-action="MeuPerfil">Meu perfil</a>
        <a asp-controller="Home" asp-action="MinhasReservas">Minhas reservas</a>
        <a asp-controller="Home" asp-action="PainelUsuario">Histórico</a>
    </nav>

    <section class="cartao-perfil">
        <h2>Informações pessoais</h2>

        @if (TempData["MSG_S"] != null)
        {
            <p class="mensagem-sucesso">@TempData["MSG_S"]</p>
        }

        <form asp-controller="Home" asp-action="MeuPerfil" method="post">
            <input type="hidden" asp-for="IDUsu" />
            <input type="hidden" asp-for="senhaUsu" />
            <input type="hidden" asp-for="situacaoUsu" />

            <div asp-validation-summary="ModelOnly" class="mensagem-erro"></div>

            <div class="campos-perfil">
                <label asp-for="CPFUsu">
                    CPF
                    <input asp-for="CPFUsu" />
                    <span asp-validation-for="CPFUsu"></span>
                </label>

                <label asp-for="nomeUsu">
                    Nome completo
                    <input asp-for="nomeUsu" />
                    <span asp-validation-for="nomeUsu"></span>
                </label>

                <label asp-for="telefoneUsu">
                    Telefone
                    <input asp-for="telefoneUsu" />
                    <span asp-validation-for="telefoneUsu"></span>
                </label>

                <label asp-for="emailUsu">
                    E-mail
                    <input asp-for="emailUsu" />
                    <span asp-validation-for="emailUsu"></span>
                </label>

                <label asp-for="dataNascimentoUsu">
                    Data de nascimento
                    <input asp-for="dataNascimentoUsu" type="date" />
                    <span asp-validation-for="dataNascimentoUsu"></span>
                </label>
            </div>

            <button type="submit" class="botao-perfil">Salvar alterações</button>
        </form>
    </section>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}