@{
    ViewData["Title"] = "Home Page";
}

<!-- BANNER INICIAL DA PÁG. -->
<div class="container-fluid p-0">
    <div class="banner">
        <img src="~/lib/img banner.jpg" alt="banner" asp-append-version="true">

        <div class="banner-conteudo">
            <h2 class="titulo-banner">VISITE DESTINOS INCRÍVEIS</h2>
            <p class="texto-banner">Descubra lugares paradisíacos e viva experiências únicas<br /> ao redor do mundo.</p>
            <button type="button" id="btn-banner" class="btn btn-primary"> Explorar Destinos</button>
        </div>

    </div>
</div>


<!-- BUSCA DE PACOTES/ DESTINOS -->
<div class="container">
    <div class="banner-busca">
        <form class="row g-2 align-items-center">
            <div class="col-12 col-md">
                <div class="campo-busca d-flex align-items-center px-2">
                    <i class="bi bi-geo-alt text-secondary me-1"></i>
                    <input type="text" class="form-control" placeholder="Origem" aria-label="Origem" />
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="campo-busca d-flex align-items-center px-2">
                    <i class="bi bi-geo-alt text-secondary me-1"></i>
                    <input type="text" class="form-control" placeholder="Destino" aria-label="Destino" />
                </div>
            </div>
            <!--mudar pra input de data-->
            <div class="col-12 col-md">
                <div class="campo-busca d-flex align-items-center px-2">
                    <i class="bi bi-calendar-event text-secondary me-1"></i>
                    <input type="text" class="form-control" placeholder="Data" aria-label="Data" />
                </div>
            </div>
            <div class="col-12 col-md">
                <div class="campo-busca d-flex align-items-center px-2">
                    <i class="bi bi-people text-secondary me-1"></i>
                    <input type="number" class="form-control" placeholder="Nº de pessoas" aria-label="Número de pessoas" />
                </div>
            </div>
            <div class="col-12 col-md-auto">
                <button type="submit" class="btn btn-login">Buscar</button>
            </div>
        </form>
    </div>
</div>


<!-- PRESENTAÇÃO DOS DESTINOS EM DESTAQUE -->
<!-- título e texto -->
<div class="container">
    <div class="text">
        <h4 class="titulo"> Destinos em destaque</h4>
        <p class="texto">Lugares incríveis esperando por você<br />Escolha se próximo destino e viva experiências únicas.</p>
    </div>
</div>

<div class="container py-5">
    <div class="row g-4 mt-1">

        <!-- card1 -->
        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card paris.jpg" asp-append-version="true" class="card-img" alt="img" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Paris, França</h3>
                    <p class="texto-card">Cidade, Luz e Romance</p>
                </div>
                <a href="#" class="btn-card" aria-label="Ver Paris"><i class="bi bi-arrow-right"></i></a>
            </article>
        </div>

        <!-- card2 -->
        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card orlando.jpeg" asp-append-version="true" class="card-img" alt="img" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Orlando, EUA</h3>
                    <p class="texto-card">Parque da Disney</p>
                </div>
                <a href="#" class="btn-card" aria-label="Ver Orlando"><i class="bi bi-arrow-right"></i></a>
            </article>
        </div>

        <!-- card3 -->
        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card copacabana.jpeg" asp-append-version="true" class="card-img" alt="img" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Copacabana, Brasil</h3>
                    <p class="texto-card">Praias incríveis</p>
                </div>
                <a href="#" class="btn-card" aria-label="Ver Copacabana"><i class="bi bi-arrow-right"></i></a>
            </article>
        </div>

        <!-- card4 -->
        <div class="col-12 col-sm-6 col-lg-3">
            <article class="card card-destino">
                <img src="~/img/card pisa.jpeg" asp-append-version="true" class="card-img" alt="img" />
                <div class="card-img-overlay">
                    <h3 class="titulo-card"><i class="bi bi-geo-alt"></i> Pisa, Itália</h3>
                    <p class="texto-card">Cidade da famosa torre</p>
                </div>
                <a href="#" class="btn-card" aria-label="Ver Pisa"><i class="bi bi-arrow-right"></i></a>
            </article>
        </div>
    </div>
    </div>
</div>

