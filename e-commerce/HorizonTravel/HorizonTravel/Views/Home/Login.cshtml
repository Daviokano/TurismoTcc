@model HorizonTravel.Models.Usuario
@{
    ViewData["Title"] = "Login";
    ViewData["SemLayout"] = true;
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="pagina-login">
    <section class="login-container">
        <aside class="login-form">
            <div class="formulario">
                <h1>Entrar</h1>

                @if (ViewData["MSG_E"] != null)
                {
                    <p class="alert alert-danger">
                        @Html.Raw(ViewData["MSG_E"])
                    </p>
                }

                <form method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label for="emailUsu">E-mail</label>
                        <input asp-for="emailUsu" class="form-control" placeholder="seu@email.com" type="email" />
                    </div>

                    <div class="form-group">
                        <label for="senhaUsu">Senha</label>
                        <input asp-for="senhaUsu" class="form-control" placeholder="Sua Senha" type="password" />
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn-login">Entrar</button>
                    </div>
                </form>

            </div>
        </aside>
    </section>
</main>
