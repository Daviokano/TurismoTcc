@model HorizonTravel.Models.Usuario

@{
    ViewData["Title"] = "Login";
    ViewData["SemLayout"] = true;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="pagina-login">

    <section class="login-container">

        <div class="imagem-login">

            <img src="~/img/cadastroimg1.jpg" alt="Praia ao amanhecer">

            <div class="banner-img">

                <div class="logo-aviao">
                    <span class="logo-icon">
                        <i class="bi bi-airplane-fill"></i>
                    </span>
                    <span class="logo-nome">Horizon Travel</span>
                </div>

                <h4>SUA PRÓXIMA AVENTURA COMEÇA AQUI!</h4>
                <p>Acesse sua conta e explore os melhores pacotes de viagem especialmente para você!</p>

            </div>

        </div>

        <aside class="login-form">

            <div class="formulario">

                <h1>Entrar</h1>

                <p class="texto1">
                    Bem-vindo de volta! Faça login na sua conta.
                </p>

                @if (ViewData["MSG_E"] != null)
                {
                    <p class="alert alert-danger">
                        @Html.Raw(ViewData["MSG_E"])
                    </p>
                }

                <form method="post">

                    <div class="form-group">
                        <label for="emailUsu">E-mail</label>
                        <div class="input-container">
                            <i class="bi bi-envelope"></i>
                            <input asp-for="emailUsu"
                                   class="form-control"
                                   placeholder="seu@email.com"
                                   type="email"
                                   required>
                        </div>
                    </div>

                    <div class="form-group senha-group">
                        <label asp-for="senhaUsu">Senha</label>
                        <div class="input-container">
                            <i class="bi bi-lock-fill"></i>
                            <input asp-for="senhaUsu"
                                   class="form-control"
                                   placeholder="Máximo 8 caracteres"
                                   type="password"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required>
                            <button type="button" class="toggle-senha" data-alvo="senhaUsu" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>

                        <a href="#" class="forgot-password">Esqueci minha senha</a>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn-login">
                            Entrar
                        </button>
                    </div>

                    <p class="register-text">
                        Ainda não tem conta?
                        <a href="~/Home/Cadastrar">Cadastre-se</a>
                    </p>

                    <p class="register-text">
                        Para fazer login como funcionário,
                        <a asp-area="Funcionario" asp-action="LoginFuncionario" asp-controller="Home">Clique aqui!</a>
                    </p>

                </form>

            </div>

        </aside>

    </section>

</main>

@section Scripts {
    <script src="~/js/cadastrar.js"></script>
    <partial name="_ValidationScriptsPartial" />
}