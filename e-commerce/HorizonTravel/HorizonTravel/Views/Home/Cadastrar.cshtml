@model HorizonTravel.Models.Usuario

@{
    ViewData["Title"] = "Cadastrar";
    ViewData["SemLayout"] = true;
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<main class="pagina-login">

    <section class="login-container">

        <div class="imagem-login">

            <img src="~/img/cadastroimg1.jpg" alt="Paisagem ao pôr do sol">

            <div class="banner-img">

                <div class="logo-aviao">
                    <span class="logo-icon">
                        <i class="bi bi-airplane-fill"></i>
                    </span>
                    <span class="logo-nome">Horizon Travel</span>
                </div>

                <h4>Junte-se a milhares de viajantes!</h4>
                <p>Crie sua conta e tenha acesso a pacotes exclusivos, ofertas especiais e muito mais.</p>

            </div>

        </div>

        <aside class="login-form">

            <div class="formulario">

                <h1>Criar conta</h1>

                <p class="texto1">
                    Preencha os dados abaixo para se cadastrar.
                </p>

                @if (ViewData["MSG_E"] != null)
                {
                    <p class="alert alert-danger">
                        @ViewData["MSG_E"]
                    </p>
                }

                <form method="post">

                    <div class="form-group">
                        <label asp-for="nomeUsu">Nome completo</label>
                        <div class="input-container">
                            <i class="bi bi-person"></i>
                            <input asp-for="nomeUsu"
                                   class="form-control"
                                   placeholder="Seu nome completo"
                                   type="text"
                                   autocomplete="name"
                                   required>
                        </div>
                        <span asp-validation-for="nomeUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CPFUsu">CPF</label>
                        <div class="input-container">
                            <i class="bi bi-person-vcard"></i>
                            <input asp-for="CPFUsu"
                                   class="form-control"
                                   placeholder="123.456.789-00"
                                   type="text"
                                   inputmode="numeric"
                                   maxlength="14"
                                   required>
                        </div>
                        <span asp-validation-for="CPFUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="CPFUsu">CPF</label>
                        <div class="input-container">
                            <i class="bi bi-person-vcard"></i>
                            <input asp-for="CPFUsu"
                                   class="form-control"
                                   placeholder="Somente números"
                                   type="text"
                                   inputmode="numeric"
                                   maxlength="14"
                                   required>
                        </div>
                        <span asp-validation-for="CPFUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="dataNascimentoUsu">Data de nascimento</label>
                        <div class="input-container">
                            <i class="bi bi-calendar-event"></i>
                            <input asp-for="dataNascimentoUsu"
                                   class="form-control"
                                   autocomplete="bday"
                                   required>
                        </div>
                        <span asp-validation-for="dataNascimentoUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="telefoneUsu">Telefone</label>
                        <div class="input-container">
                            <i class="bi bi-telephone"></i>
                            <input asp-for="telefoneUsu"
                                   class="form-control"
                                   placeholder="(11) 99999-9999"
                                   type="tel"
                                   maxlength="15"
                                   autocomplete="tel">
                        </div>
                        <span asp-validation-for="telefoneUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="senhaUsu">Senha</label>
                        <div class="input-container">
                            <i class="bi bi-lock"></i>
                            <input asp-for="senhaUsu"
                                   class="form-control"
                                   placeholder="Mínimo 8 caracteres"
                                   type="password"
                                   minlength="8"
                                   autocomplete="new-password"
                                   required>
                            <button type="button" class="toggle-senha" data-alvo="senhaUsu" aria-label="Mostrar senha">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="senhaUsu" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn-login">
                            Criar conta
                        </button>
                    </div>

                    <p class="register-text">
                        Já tem conta?
                        <a asp-controller="Home" asp-action="Login">Entrar</a>
                    </p>

                </form>

            </div>

        </aside>

    </section>

</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/cadastrar.js"></script>
}