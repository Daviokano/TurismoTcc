@model HorizonTravel.Models.Usuario

@{
    ViewData["Title"] = "Minhas reservas";
}

<link rel="stylesheet" href="~/css/reservas-usuario.css" asp-append-version="true" />

<section class="pagina-usuario">
    <div class="cabecalho-usuario">
        <div class="avatar-usuario">@Model.nomeUsu.Substring(0, 1).ToUpper()</div>
        <div>
            <h1>@Model.nomeUsu</h1>
            <p>@Model.emailUsu</p>
        </div>
    </div>

    <nav class="abas-usuario" aria-label="Navegação do usuário">
        <a asp-controller="Home" asp-action="MeuPerfil">Meu perfil</a>
        <a class="aba-ativa" asp-controller="Home" asp-action="MinhasReservas">Minhas reservas</a>
        <a asp-controller="Home" asp-action="PainelUsuario">Histórico</a>
    </nav>

    <section class="lista-reservas" aria-label="Lista de reservas">
        <article class="cartao-reserva">
            <div>
                <h2>Pacote Rio de Janeiro</h2>
                <p><i class="bi bi-geo-alt"></i> Rio de Janeiro - Brasil</p>
                <p><i class="bi bi-calendar3"></i> Partida: 15/01/2027 - 2 passageiros</p>
            </div>
            <div class="dados-reserva">
                <strong>R$ 9.000</strong>
                <span class="status-reserva">Confirmado</span>
                <small>#HT1294821</small>
            </div>
        </article>

        <article class="cartao-reserva">
            <div>
                <h2>Paris</h2>
                <p><i class="bi bi-geo-alt"></i> Paris - França</p>
                <p><i class="bi bi-calendar3"></i> Partida: 20/11/2026 - 1 passageiro</p>
            </div>
            <div class="dados-reserva">
                <strong>R$ 17.800</strong>
                <span class="status-reserva">Confirmado</span>
                <small>#HT1297721</small>
            </div>
        </article>

        <article class="cartao-reserva">
            <div>
                <h2>Turquia</h2>
                <p><i class="bi bi-geo-alt"></i> Turquia - Japão</p>
                <p><i class="bi bi-calendar3"></i> Partida: 08/12/2026 - 2 passageiros</p>
            </div>
            <div class="dados-reserva">
                <strong>R$ 11.500</strong>
                <span class="status-reserva">Confirmado</span>
                <small>#HT004821</small>
            </div>
        </article>
    </section>
</section>