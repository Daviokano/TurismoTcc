@{
    ViewData["Title"] = "Detalhes do pacote";
}

<link rel="stylesheet" href="~/css/detalhes-pacote-portugues.css" asp-append-version="true" />

<section class="banner-detalhes-pacote">
    <img src="~/img/img banner.jpg" alt="Paisagem do destino" />
    <div class="conteudo-banner-detalhes">
        <h1>RIO DE JANEIRO</h1>
        <div class="informacoes-pacote">
            <span><i class="bi bi-geo-alt"></i> Rio de Janeiro, Brasil</span>
            <span><i class="bi bi-clock"></i> 14 dias</span>
            <span><i class="bi bi-people"></i> até 2 pessoas</span>
        </div>
        <p><i class="bi bi-building"></i> Hotel Windsor Atlantica <span class="estrelas">★★★★</span></p>
    </div>
</section>

<main class="estrutura-detalhes">
    <div class="conteudo-detalhes">
        <section class="cartao-detalhes">
            <h2>Pacote Rio de Janeiro</h2>
            <p>
                Viva o melhor da Cidade Maravilhosa neste pacote completo de 14 dias! Cristo Redentor, Pão de Açúcar, 
                as praias de Copacabana e Ipanema, o bairro boêmio da Lapa, Santa Teresa e muito mais.
            </p>
            <p>Com guia local brasileiro, hotel 4 estrelas à beira-mar e transportes incluídos.</p>
            <p>
                Durante a viagem, você poderá conhecer os principais pontos turísticos do Rio de Janeiro,
                aproveitar as praias mais famosas da cidade e explorar experiências culturais e gastronômicas
                especialmente selecionadas para tornar sua estadia ainda mais completa.
            </p>
            <p>
                O pacote foi planejado para oferecer conforto, segurança e praticidade em todos os momentos,
                com suporte da nossa equipe durante toda a viagem e horários organizados para que você aproveite
                cada paisagem da Cidade Maravilhosa.
            </p>

            <h3>O que está incluso?</h3>
            <div class="itens-inclusos">
                <span><i class="bi bi-airplane"></i> Passagem aérea ida e volta</span>
                <span><i class="bi bi-car-front-fill"></i> Transporte</span>
                <span><i class="bi bi-building"></i> Hotel 4 estrelas</span>
                <span><i class="bi bi-person-badge"></i> Guia turístico brasileiro</span>
            </div>
        </section>

    </div>

    <div class="cartao-detalhes reserva-pacote">
        <span class="a-partir">a partir de:</span>
        <strong class="preco">4.500</strong>
        <span class="por-pessoa">por pessoa / 14 dias</span>
        <hr />
        
        <label>
            data de partida
            <input type="date" />
        </label>
        
        <label>
            número de pessoas
            <select>
                <option>1 pessoa</option>
                <option>2 pessoas</option>
                <option>3 pessoas</option>
            </select>
        </label>
        
        <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
            <input type="hidden" name="IdPacote" value="1" />
            <input type="hidden" name="NomePacote" value="Pacote Rio de Janeiro" />
            <input type="hidden" name="Destino" value="Rio de Janeiro, Brasil" />
            <input type="hidden" name="Preco" value="4500" />
            <button type="submit">Adicionar ao carrinho</button>
        </form>
        
        <ul>
            <li>Cancelamento gratuito até 30 dias antes</li>
            <li>Pagamento em até 12x sem juros</li>
            <li>Suporte 24h durante toda a viagem</li>
        </ul>
    </div>
</main>
