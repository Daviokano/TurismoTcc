@model HorizonTravel.Models.Pacote

@{
    ViewData["Title"] = "Detalhes do pacote";
    var promocao = ViewBag.Promocao as HorizonTravel.Models.Promocao;
    var precoPromocional = promocao == null
        ? Model.precoPac
        : Math.Round(Model.precoPac * (1 - promocao.porcentagemDesconto / 100), 2);
}

<link rel="stylesheet" href="~/css/detalhes-pacote-portugues.css" asp-append-version="true" />

<section class="banner-detalhes-pacote">
    <img src="~/img/img banner.jpg" alt="Paisagem do destino" />
    <div class="conteudo-banner-detalhes">
        <h1>@Model.destinoPac</h1>
        <div class="informacoes-pacote">
            <span><i class="bi bi-geo-alt"></i> @Model.destinoPac</span>
            <span><i class="bi bi-calendar-event"></i> @Model.dataPac.ToString("dd/MM/yyyy")</span>
            <span><i class="bi bi-people"></i> @Model.quantidadePac vagas</span>
        </div>
        <p><i class="bi bi-building"></i> Hotel Windsor Atlantica <span class="estrelas">★★★★</span></p>
    </div>
</section>

<main class="estrutura-detalhes">
    <div class="conteudo-detalhes">
        <section class="cartao-detalhes">
            <h2>Pacote Rio de Janeiro</h2>
            <p>@Model.descricaoPac</p>
        </section>

    </div>

    <div class="cartao-detalhes reserva-pacote">
        <span class="a-partir">a partir de:</span>
        @if (promocao != null)
        {
            <span class="preco-original">R$ @Model.precoPac.ToString("N2")</span>
            <span class="etiqueta-desconto-detalhes">@promocao.porcentagemDesconto.ToString("0.##")% OFF</span>
        }
        <strong class="preco">R$ @precoPromocional.ToString("N2")</strong>
        <span class="por-pessoa">por pacote</span>
        @if (promocao != null)
        {
            <small class="validade-promocao">Oferta válida até @promocao.dataValidade.ToString("dd/MM/yyyy")</small>
        }
        <hr />
        
        <div class="informacao-fixa-pacote">
            <span class="rotulo-informacao-pacote">data de partida</span>
            <strong><i class="bi bi-calendar-event"></i> @Model.dataPac.ToString("dd/MM/yyyy")</strong>
        </div>

        <div class="informacao-fixa-pacote">
            <span class="rotulo-informacao-pacote">vagas disponíveis</span>
            <strong><i class="bi bi-people"></i> @Model.quantidadePac pessoas</strong>
        </div>
        
        <form asp-controller="Carrinho" asp-action="Adicionar" method="post">
            <input type="hidden" name="IdPacote" value="@Model.IDPac" />
            <input type="hidden" name="NomePacote" value="Pacote @Model.destinoPac" />
            <input type="hidden" name="Destino" value="@Model.destinoPac" />
            <input type="hidden" name="Preco" value="@Model.precoPac" />
            <input type="hidden" name="Imagem" value="@Model.fotoPac" />
            <button type="submit">Adicionar ao carrinho</button>
        </form>
        
        <ul>
            <li>Cancelamento gratuito até 30 dias antes</li>
            <li>Pagamento em até 12x sem juros</li>
            <li>Suporte 24h durante toda a viagem</li>
        </ul>
    </div>
</main>
