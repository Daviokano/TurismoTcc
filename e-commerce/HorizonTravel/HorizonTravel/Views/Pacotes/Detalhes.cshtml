<section class="banner-detalhes-pacote"><img src="~/img/img banner.jpg" alt="Paisagem do destino" /><div class="conteudo-banner-detalhes"><h1>RIO DE JANEIRO</h1><div class="informacoes-pacote"><span><i class="bi bi-geo-alt"></i> Rio de Janeiro, Brasil</span><span><i class="bi bi-clock"></i> 14 dias</span><span><i class="bi bi-people"></i> até 2 pessoas</span></div><p><i class="bi bi-building"></i> Hotel Windsor Atlantica <span class="estrelas">★★★★</span></p></div></section>
<main class="estrutura-detalhes"><div class="conteudo-detalhes"><section class="cartao-detalhes"><h2>Pacote Rio de Janeiro</h2><p>Viva o melhor da Cidade Maravilhosa neste pacote completo de 14 dias! Cristo Redentor, Pão de Açúcar, as praias de Copacabana e Ipanema, o bairro boêmio da Lapa, Santa Teresa e muito mais.</p><p>Com guia local brasileiro, hotel 4 estrelas à beira-mar e transportes incluídos.</p><h3>O que está incluso?</h3><div class="itens-inclusos"><span><i class="bi bi-airplane"></i> Passagem aérea ida e volta</span><span><i class="bi bi-car-front-fill"></i> Transporte</span><span><i class="bi bi-building"></i> Hotel 4 estrelas</span><span><i class="bi bi-person-badge"></i> Guia turístico brasileiro</span></div></section><section class="cartao-detalhes roteiro-pacote"><h2>Itinerário</h2>@foreach (var item in new[] { ("Chegada", "Recepção no aeroporto com transfer ao hotel."), ("Cristo Redentor e Pão de Açúcar", "Manhã no Cristo Redentor via trem do Corcovado."), ("Copacabana e Ipanema", "Dia nas praias mais famosas do mundo com guia."), ("Lapa e Santa Teresa", "Visita aos Arcos e à Escadaria Selarón."), ("Museu do Amanhã e Porto Maravilha", "Passeio pelo Porto Maravilha."), ("Jardim Botânico e Tijuca", "Visita ao Jardim Botânico e à Floresta da Tijuca."), ("Dia Livre — Praia ou Compras", "Dia à disposição para explorar a cidade.") }) { <article class="etapa-roteiro"><strong>@(Array.IndexOf(new[] { "Chegada", "Cristo Redentor e Pão de Açúcar", "Copacabana e Ipanema", "Lapa e Santa Teresa", "Museu do Amanhã e Porto Maravilha", "Jardim Botânico e Tijuca", "Dia Livre — Praia ou Compras" }, item.Item1) + 1)</strong><div><h3>@item.Item1</h3><p>@item.Item2</p></div></article> }</section></div><aside class="cartao-detalhes reserva-pacote"><span class="a-partir">a partir de:</span><strong class="preco">4.500</strong><span class="por-pessoa">por pessoa / 14 dias</span><hr /><label>data de partida<input type="date" /></label><label>número de pessoas<select><option>1 pessoa</option><option>2 pessoas</option><option>3 pessoas</option></select></label><button type="button">Reservar Agora</button><ul><li>Cancelamento gratuito até 30 dias antes</li><li>Pagamento em até 12x sem juros</li><li>Suporte 24h durante toda a viagem</li></ul></aside></main>
