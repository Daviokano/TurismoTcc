@{
    ViewData["Title"] = "Sobre";
}

<link rel="stylesheet" href="~/css/sobre.css" asp-append-version="true" />

<section class="banner-sobre">
    <img src="~/img/img banner.jpg" alt="Paisagem de viagem" />
    <div class="conteudo-banner-sobre">
        <h1>SOBRE A<br />HORIZON TRAVEL</h1>
        <p>Planejamos experiências inesquecíveis para você.</p>
    </div>
</section>

<section class="apresentacao-sobre container">
    <img src="~/img/card paris.jpg" alt="Destino de viagem" />
    <div>
        <small>SOBRE A <strong>HORIZON TRAVEL</strong></small>
        <h2>Viajamos com você em cada momento</h2>
        <p>Oferecemos experiências de viagem planejadas com cuidado, segurança e praticidade para que você aproveite cada momento do início ao fim.</p>
    </div>
</section>

<section class="numeros-sobre">
    <div><strong>50k+</strong><span>Clientes satisfeitos</span></div>
    <div><strong>+40</strong><span>Pacotes exclusivos</span></div>
    <div><strong>+10</strong><span>Destinos disponíveis</span></div>
    <div><strong>000</strong><span>Clientes satisfeitos</span></div>
</section>

<section class="valores-sobre container">
    <article><i class="bi bi-airplane"></i><h3>Nossa Missão</h3><p>Proporcionar experiências de viagem únicas, seguras e acessíveis.</p></article>
    <article><i class="bi bi-eye"></i><h3>Nossa Visão</h3><p>Ser a agência mais confiável em viagens personalizadas.</p></article>
    <article><i class="bi bi-heart"></i><h3>Nossos Valores</h3><p>Transparência, excelência no atendimento e respeito ao cliente.</p></article>
</section>

<section class="diferenciais-sobre container">
    <h2>POR QUE ESCOLHER A HORIZON?</h2>
    <div class="lista-diferenciais">
        <article><i class="bi bi-bookmark-check"></i><h3>Pacotes Exclusivos</h3><p>Roteiros planejados para diferentes estilos de viajantes.</p></article>
        <article><i class="bi bi-building"></i><h3>Pacotes Exclusivos</h3><p>Roteiros planejados para diferentes estilos de viajantes.</p></article>
        <article><i class="bi bi-shield-check"></i><h3>Pacotes Exclusivos</h3><p>Roteiros planejados para diferentes estilos de viajantes.</p></article>
        <article><i class="bi bi-currency-dollar"></i><h3>Pacotes Exclusivos</h3><p>Roteiros planejados para diferentes estilos de viajantes.</p></article>
    </div>
</section>

<section class="contato-sobre">
    <div class="container contato-conteudo-sobre">
        <div class="formulario-sobre">
            <h2>ENTRE EM CONTATO</h2>
            <p>Estamos prontos para ajudar você a planejar sua próxima viagem.</p>
            <form>
                <input placeholder="Nome completo" />
                <div><input placeholder="E-mail" /><input placeholder="Telefone" /></div>
                <input placeholder="Assunto" />
                <textarea placeholder="Mensagem..."></textarea>
                <button type="button">ENVIAR MENSAGEM</button>
            </form>
        </div>
        <div class="informacoes-sobre">
            <h3>Informações de contato</h3>
            <p><i class="bi bi-envelope-fill"></i> contato@horizontravel.com</p>
            <p><i class="bi bi-telephone-fill"></i> (11) 400-2026</p>
            <p><i class="bi bi-clock"></i> Segunda à Sexta<br />das 8h às 18h</p>
        </div>
    </div>
</section>

<div class="mapa-sobre"></div>
