@model HorizonTravel.Models.Promocao
@{ ViewData["Title"] = "Editar promoção"; }
<link rel="stylesheet" href="~/css/promocoes-funcionario.css" asp-append-version="true" />
<div class="pagina-formulario-promocao"><div class="cabecalho-promocoes-funcionario"><div><h1>Editar promoção</h1><p>Atualize o desconto ou a data limite da promoção.</p></div></div><section class="cartao-formulario-promocao"><form asp-action="Atualizar" method="post"><input asp-for="IDPromo" type="hidden" /><div asp-validation-summary="ModelOnly" class="erro-promocao"></div><div class="campo-promocao"><label asp-for="porcentagemDesconto">Desconto (%)</label><input asp-for="porcentagemDesconto" type="number" min="0" max="100" step="0.01" /><span asp-validation-for="porcentagemDesconto" class="erro-promocao"></span></div><div class="campo-promocao"><label asp-for="dataValidade">Data limite</label><input asp-for="dataValidade" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" /><span asp-validation-for="dataValidade" class="erro-promocao"></span></div><div class="acoes-formulario-promocao"><a asp-action="Index">Cancelar</a><button type="submit">Salvar alterações</button></div></form></section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
