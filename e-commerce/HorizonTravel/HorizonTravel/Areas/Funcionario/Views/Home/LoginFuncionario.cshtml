@model HorizonTravel.Models.Funcionario
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="stylesheet" href="~/css/loginfuncionario.css" asp-append-version="true" />

<main role="main">

    <section class="container">
        <aside class="col-sm-6">
            <h3 class="subtitle-doc">
                Login do Funcionário
            </h3>

            <div id="code_login_1">
                <div class="card">
                    <article class="card-body">

                        @if (ViewData["MSG_E"] != null)
                        {
                            <p class="alert alert-danger">@Html.Raw(ViewData["MSG_E"])</p>
                        }

                        <h4 class="card-title mb-4 mt-1">Entrar</h4>

                        <form method="post">
                            @Html.AntiForgeryToken()

                            <div class="form-group">
                                <label for="emailFun">E-mail</label>
                                <div class="input-container">
                                    <i class="bi bi-envelope"></i>
                                    <input asp-for="emailFun"
                                           class="form-control"
                                           placeholder="seu@email.com"
                                           type="email"
                                           required>
                                </div>
                            </div>

                            <div class="form-group senha-group">
                                <label asp-for="senhaFun">Senha</label>
                                <div class="input-container">
                                    <i class="bi bi-lock"></i>
                                    <input asp-for="senhaFun"
                                           class="form-control"
                                           placeholder="Sua Senha"
                                           type="password"
                                           minlength="8"
                                           autocomplete="new-password"
                                           required>
                                    <button type="button" class="toggle-senha" data-alvo="senhaFun" aria-label="Mostrar senha">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>

                                <a href="#" class="forgot-password">Esqueci minha senha</a>
                            </div>

                            <div class="form-group">
                                <button type="submit"
                                        class="btn btn-primary btn-block">
                                    Acessar
                                </button>
                            </div>

                        </form>

                    </article>
                </div>
            </div>

        </aside>
    </section>

</main>

<script src="~/js/cadastrar.js"></script>
<partial name="_ValidationScriptsPartial" />