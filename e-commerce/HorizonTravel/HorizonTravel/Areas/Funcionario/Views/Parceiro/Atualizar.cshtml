@model HorizonTravel.Models.Parceiro
@{
    ViewBag.Title = "Atualizar Parceiro";
    Layout = "~/Areas/Funcionario/Views/Shared/_Layout.cshtml";
}

<h2>Atualizar Parceiro</h2>
<form asp-action="Cadastrar" method="post" id="formCadastroParceiro" class="form-cadastro">
    <input type="hidden" name="situacaoFor" value="A" />

    <div class="grade-cadastro">

        <div class="campo-form">
            <label for="nomeFor" class="rotulo-form">Nome do parceiro</label>
            <input type="text" id="nomeFor" name="nomeFor" class="input-form"
                   placeholder="Digite o nome do parceiro" maxlength="100" required />
        </div>

        <div class="campo-form">
            <label for="CNPJFor" class="rotulo-form">CNPJ</label>
            <input type="text" id="CNPJFor" name="CNPJFor" class="input-form CNPJ"
                   placeholder="00.000.000/0000-00" inputmode="numeric" maxlength="18" required />
        </div>

        <div class="campo-form">
            <label for="emailFor" class="rotulo-form">E-mail</label>
            <input type="email" id="emailFor" name="emailFor" class="input-form"
                   placeholder="exemplo@gmail.com" maxlength="100" required />
        </div>

    </div>

    <div class="acoes-form">
        <button type="reset" class="botao-cancelar">Cancelar</button>
        <button type="submit" class="botao-cadastrar">Atualizar</button>
    </div>
</form>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
