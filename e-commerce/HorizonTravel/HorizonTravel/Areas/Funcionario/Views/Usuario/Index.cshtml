@using HorizonTravel.Models
@model IEnumerable<HorizonTravel.Models.Usuario>

@{
    ViewData["Title"] = "Usuários";
}

<link rel="stylesheet" href="~/css/listausuario.css" asp-append-version="true" />

<div class="pagina-lista">
    <div class="cabecalho-lista">
        <div>
            <h1 class="titulo-lista">Usuários</h1>
            <p class="subtitulo-lista">Gerencie os usuários cadastrados no sistema.</p>
        </div>

        <a asp-action="Cadastrar" class="botao-novo">
            <span class="fas fa-user-plus" aria-hidden="true"></span>
            <span>Cadastrar novo usuário</span>
        </a>
    </div>

    <div class="campo-busca">
        <span class="fas fa-search icone-busca" aria-hidden="true"></span>
        <input type="text" id="campoBusca" class="input-busca"
               placeholder="Buscar usuário por nome ou CPF..." autocomplete="off" />
    </div>

    <div class="cartao-tabela">
        <table class="tabela-usuarios" id="tabelaUsuarios">
            <thead>
                <tr>
                    <th>Usuário</th>
                    <th>CPF</th>
                    <th>E-mail</th>
                    <th>Telefone</th>
                    <th>Nascimento</th>
                    <th>Status</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (Usuario usuario in Model)
                {
                    string iniciais = "";
                    if (!string.IsNullOrWhiteSpace(usuario.nomeUsu))
                    {
                        var partes = usuario.nomeUsu.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
                        iniciais = partes.Length > 1
                            ? $"{partes[0][0]}{partes[partes.Length - 1][0]}"
                            : $"{partes[0][0]}";
                        iniciais = iniciais.ToUpper();
                    }

                    <tr class="linha-usuario">
                        <td>
                            <div class="celula-usuario">
                                <span class="avatar-iniciais">@iniciais</span>
                                <span class="nome-usuario">@usuario.nomeUsu</span>
                            </div>
                        </td>
                        <td class="cpf-usuario">@usuario.CPFUsu</td>
                        <td>@usuario.emailUsu</td>
                        <td>@usuario.telefoneUsu</td>
                        <td>@usuario.dataNascimentoUsu.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (usuario.situacaoUsu == "A")
                            {
                                <span class="selo selo-ativo">Ativo</span>
                            }
                            else
                            {
                                <span class="selo selo-inativo">Inativo</span>
                            }
                        </td>
                        <td>
                            @if (usuario.situacaoUsu == "A")
                            {
                                <a asp-action="Desativar" asp-route-id="@usuario.IDUsu"
                                   class="botao-acao botao-desativar"
                                   onclick="return confirm('Realmente deseja desativar esse usuário?');">Desativar</a>
                            }
                            else
                            {
                                <a asp-action="Ativar" asp-route-id="@usuario.IDUsu"
                                   class="botao-acao botao-ativar"
                                   onclick="return confirm('Realmente deseja ativar esse usuário?');">Ativar</a>
                            }
                        </td>
                    </tr>
                }

                <tr id="linhaSemResultado" class="linha-sem-resultado" hidden>
                    <td colspan="7">Nenhum usuário encontrado.</td>
                </tr>
            </tbody>
        </table>
    </div>

    <div class="paginacao">
        <button type="button" class="botao-pagina" aria-label="Página anterior">&lsaquo;</button>
        <button type="button" class="botao-pagina pagina-atual">1</button>
        <button type="button" class="botao-pagina" aria-label="Próxima página">&rsaquo;</button>
    </div>
</div>

@section Scripts {
    <script src="~/js/listausuario.js" asp-append-version="true"></script>
}