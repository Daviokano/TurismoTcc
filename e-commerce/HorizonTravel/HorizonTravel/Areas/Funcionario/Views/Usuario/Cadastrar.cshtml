@model HorizonTravel.Models.Usuario

@{
    ViewData["Title"] = "Cadastrar";
}

<h1>Cadastrar</h1>


<form asp-action="Cadastrar" asp-controller="Home" method="post">
    <main role="main">

        <section class="container" style="margin-top: 50px">
            <div class="row">
                <aside class="col-sm-6">
                    <h3 class="subtitle-doc">
                        Cadastro do usuário
                    </h3>
                    <div id="code_register_1">
                        <div class="card">
                            <header class="card-header">
                                <a asp-controller="Home" asp-action="Login" class="float-right btn btn-outline-primary mt-1">Entrar</a>
                                <h4 class="card-title mt-2">Cadastro</h4>
                            </header>
                            <article class="card-body">
                                @if (TempData["MSG_S"] != null)
                                {
                                    <p class="alert alert-success">@TempData["MSG_S"]</p>
                                }
                                <div class="form-row">
                                    <div class="col form-group">
                                        <label asp-for="nomeUsu">Nome</label>
                                        <input type="text" asp-for="nomeUsu" class="form-control" placeholder="">
                                        <span asp-validation-for="nomeUsu"></span>
                                    </div>
                                    <div class="col form-group">
                                        <label asp-for="dataNascismentoUsu">Nascimento</label>
                                        <input type="text" asp-for="dataNascismentoUsu" class="form-control" placeholder="">
                                        <span asp-validation-for="dataNascismentoUsu"></span>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <label asp-for="CPFUsu">CPF</label>
                                    <input type="text" asp-for="CPFUsu" class="form-control" placeholder="">
                                    <span asp-validation-for="CPFUsu"></span>
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-md-6">
                                        <label asp-for="telefoneUsu">Telefone</label>
                                        <input type="text" asp-for="telefoneUsu" class="form-control">
                                        <span asp-validation-for="telefoneUsu"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="emailUsu">Email</label>
                                        <input type="text" asp-for="emailUsu" class="form-control" placeholder="">
                                        <span asp-validation-for="emailUsu"></span>
                                    </div>
                                    <div class="form-group">
                                        <label asp-for="senhaUsu">Senha</label>
                                        <input class="form-control" asp-for="senhaUsu" type="password">
                                        <span asp-validation-for="senhaUsu"></span>
                                    </div>
                                    <div class="form-group">
                                        <button type="submit" class="btn btn-primary btn-block"> Cadastrar </button>
                                    </div>
                                </div>

                            </article>
                            <div class="border-top card-body text-center">Já tem um conta? <a asp-action="Login" asp-controller="Usuario">Entrar</a></div>
                        </div>
                    </div>
                </aside>
            </div>
        </section>
    </main>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
