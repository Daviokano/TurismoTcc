@model IEnumerable<HorizonTravel.Models.Usuario>
@{
    ViewData["Title"] = "Usuários";
}

@functions {
    string ObterIniciais(string nome)
    {
        if (string.IsNullOrWhiteSpace(nome))
        {
            return "?";
        }

        var partes = nome.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (partes.Length == 1)
        {
            return partes[0][0].ToString().ToUpper();
        }

        return (partes[0][0].ToString() + partes[partes.Length - 1][0].ToString()).ToUpper();
    }
}

<link rel="stylesheet" href="~/css/telacontroleusuario.css" asp-append-version="true" />

<div class="cabecalho-pagina">
    <div>
        <h1 class="titulo-pagina">Usuários</h1>
        <p class="subtitulo-pagina">Gerencie os usuários cadastrados no sistema.</p>
    </div>

    <a asp-action="Cadastrar" class="botao-novo">Novo Usuário</a>
</div>

<div class="caixa-busca">
    <i class="bi bi-search"></i>
    <input type="text"
           id="campoBusca"
           class="campo-busca"
           autocomplete="off"
           placeholder="Buscar usuário por nome ou CPF..." />
</div>

<div class="tabela-container">
    <table class="tabela-usuarios" id="tabelaUsuarios">
        <thead>
            <tr>
                <th>Usuário</th>
                <th>@Html.DisplayNameFor(model => model.First().CPFUsu)</th>
                <th>@Html.DisplayNameFor(model => model.First().emailUsu)</th>
                <th>@Html.DisplayNameFor(model => model.First().telefoneUsu)</th>
                <th>@Html.DisplayNameFor(model => model.First().dataNascimentoUsu)</th>
                <th>Status</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr class="linha-usuario">
                    <td>
                        <div class="usuario-info">
                            <span class="avatar">@ObterIniciais(item.nomeUsu)</span>
                            <span class="nome-usuario">@item.nomeUsu</span>
                        </div>
                    </td>
                    <td class="cpf-usuario">@item.CPFUsu</td>
                    <td>@item.emailUsu</td>
                    <td>@item.telefoneUsu</td>
                    <td>@item.dataNascimentoUsu.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (item.situacaoUsu == "A")
                        {
                            <span class="selo selo-ativo">Ativo</span>
                        }
                        else
                        {
                            <span class="selo selo-inativo">Inativo</span>
                        }
                    </td>
                    <td>
                        <div class="grupo-acoes">
                            @if (item.situacaoUsu == "A")
                            {
                                <a asp-action="Desativar" asp-route-id="@item.IDUsu"
                                   class="botao-acao botao-excluir"
                                   onclick="return confirm('Realmente deseja desativar esse usuário?');">Desativar</a>
                            }
                            else
                            {
                                <a asp-action="Ativar" asp-route-id="@item.IDUsu"
                                   class="botao-acao botao-ativar"
                                   onclick="return confirm('Realmente deseja ativar esse usuário?');">Ativar</a>
                            }
                        </div>
                    </td>
                </tr>
            }

            <tr id="linhaSemResultado" class="linha-sem-resultado" @(Model.Any() ? "hidden" : "")>
                <td colspan="7" class="tabela-vazia">Nenhum usuário encontrado.</td>
            </tr>
        </tbody>
    </table>
</div>

<script src="~/js/listausuario.js" asp-append-version="true"></script>