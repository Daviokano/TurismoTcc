@using HorizonTravel.Libraries.Login;
@inject HorizonTravel.Libraries.Login.LoginFuncionario _funcionario


<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Mark Otto, Jacob Thornton, and Bootstrap contributors">
    <meta name="generator" content="Jekyll v3.8.5">
    <title>@ViewBag.Title</title>

    <link href="~/css/StyleSheet.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="~/resources/lib/bootstrap-4.2.1-dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/resources/lib/pagedlist/PagedList.css" rel="stylesheet" type="text/css" />
    <link href="~/resources/lib/pagedlist/PagedList.css" rel="stylesheet" type="text/css" /> 
    <link href="~/resources/lib/dashboard/dashboard.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/layoutfuncionario.css" asp-append-version="true" />

</head>

<body>
    <nav class="navbar navbar-dark fixed-top bg-dark flex-md-nowrap p-0 shadow">
        <a class="navbar-brand col-sm-3 col-md-2 mr-0" href="#">Painel</a>
        <input class="form-control form-control-dark w-100" type="text" placeholder="Search" aria-label="Search">

        <ul class="navbar-nav px-3">
            <li class="nav-item text-nowrap">
                <a class="nav-link" asp-area="Funcionario" asp-action="Logout"
                asp-controller="Home"><span>@(_funcionario.GetFuncionario()?.nomeFun)</span> Sair</a>
            </li>
        </ul>
    </nav>
    <aside class="sidebar-ht">
        <div class="sidebar-brand">
            <span data-feather="send"></span>
            <i class="bi bi-airplane"></i>
            Horizon Travel
        </div>

        <ul class="sidebar-menu">
            <li>
                <a class="active" asp-action="PainelFuncionario">
                    <i class="bi bi-house-door"></i>
                    Painel de Controle
                </a>
            </li>
            <li>
                <a asp-action="Index" asp-controller="Categoria">
                    <i class="bi bi-box-seam"></i>
                     Pacotes
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bi bi-megaphone"></i>
                     Promoções
                </a>
            </li>
            <li>
                <a asp-controller="Funcionario" asp-action="Index">
                    <i class="bi bi-people"></i>
                     Funcionários
                </a>
            </li>
            <li>
                <a asp-controller="Usuario" asp-action="Index">
                    <i class="bi bi-clock-history"></i>
                     Histórico por cliente
                </a>
            </li>
            <li>
                <a href="#">
                    <i class="bi bi-people"></i>
                     Parceiros
                </a>
            </li>
        </ul>

        <a class="sidebar-logout" asp-area="Funcionario" asp-controller="Home" asp-action="Logout">
            <i class="bi bi-box-arrow-right"></i>
            Sair
        </a>
    </aside>

    <main class="conteudo-principal">
        @RenderBody()
    </main>

    <script src="~/resources/lib/jquery3.3.1/jquery-3.3.1.min.js"></script>
    <script>window.jQuery || document.write('<script src="/resources/lib/jquery3.3.1/jquery-3.3.1.min.js"><\/script>')</script>
    <script src="~/resources/lib/mask/jquery.mask.min.js"></script>
    <script src="~/resources/lib/bootstrap-4.2.1-dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/resources/lib/feather/feather.js"></script>
    <script src="~/resources/lib/charts/charts.js"></script>
    <script src="~/resources/lib/dashboard/dashboard.js"></script>
    <script src="~/resources/js/Actions.js"></script>
</body>
</html>