@model HorizonTravel.Models.Pacote

@{
    ViewData["Title"] = "Detalhes do pacote";
}

<link rel="stylesheet" href="~/css/pacotes-funcionario.css" asp-append-version="true" />

<main class="detalhes-pacote-funcionario">
    <header class="cabecalho-detalhes-pacote-funcionario">
        <div>
            <span class="rotulo-detalhes-pacote-funcionario">Visualização do pacote</span>
            <h1>@Model.destinoPac</h1>
            <p>@Model.origemPac → @Model.destinoPac</p>
        </div>
        <span class="status-detalhes-pacote-funcionario">@(Model.quantidadePac > 0 ? "Disponível" : "Esgotado")</span>
    </header>

    <section class="resumo-detalhes-pacote-funcionario" aria-label="Resumo do pacote">
        <article class="item-resumo-pacote">
            <span>Data de partida</span>
            <strong>@Model.dataPac.ToString("dd/MM/yyyy")</strong>
        </article>
        <article class="item-resumo-pacote">
            <span>Preço</span>
            <strong>R$ @Model.precoPac.ToString("N2")</strong>
        </article>
        <article class="item-resumo-pacote">
            <span>Vagas disponíveis</span>
            <strong>@Model.quantidadePac</strong>
        </article>
    </section>

    <section class="descricao-detalhes-pacote-funcionario">
        <h2>Descrição</h2>
        <p>@Model.descricaoPac</p>
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.fotoPac))
    {
        <figure class="imagem-detalhes-pacote">
            <img src="~/@Model.fotoPac" alt="Pacote para @Model.destinoPac" />
        </figure>
    }

    <a class="botao-voltar-detalhes-pacote-funcionario" asp-action="Index">Voltar para pacotes</a>
</main>
